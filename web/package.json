{
  "name": "@infoconex/analytics-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:lab": "node --test scripts/ux13/*.test.mjs && node scripts/ux13/lab-fixtures.mjs check",
    "test:e2e": "playwright test",
    "visual:evidence": "playwright test e2e/visual.spec.ts",
    "visual:ui-only": "playwright test --config playwright.visual-only.config.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
